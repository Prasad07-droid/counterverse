# CounterVerse — Environment Variables Template
# Copy to .env and fill in values (never commit .env to git)
# 
# Current architecture is zero-credential — no keys required.
# This file is provided for future extensibility.

# UN Comtrade API (optional — public preview endpoint used by default)
# COMTRADE_API_KEY=your_key_here

# HuggingFace (optional — only needed for gated model repos)
# HUGGINGFACE_TOKEN=your_token_here

# Streamlit Cloud secrets are managed via the Streamlit dashboard
# not via .env — see: https://docs.streamlit.io/deploy/secrets
